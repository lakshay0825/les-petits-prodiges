  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      {
        "type": "color",
        "id": "color_cream",
        "label": "Cream",
        "default": "#FCF6ED"
      },
      {
        "type": "color",
        "id": "color_white",
        "label": "White",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink",
        "default": "#0D0D0D"
      },
      {
        "type": "color",
        "id": "color_ink_soft",
        "label": "Ink soft",
        "default": "#353535"
      },
      {
        "type": "color",
        "id": "color_announcement_bg",
        "label": "Announcement background",
        "default": "#FCF6ED"
      },
      {
        "type": "color",
        "id": "color_announcement_text",
        "label": "Announcement text",
        "default": "#0D0D0D"
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "montserrat_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 110,
        "step": 1,
        "unit": "%",
        "label": "Body scale",
        "default": 100
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 8,
        "unit": "px",
        "label": "Page width",
        "default": 1512
      },
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable cart drawer",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings_schema.social.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings_schema.social.settings.paragraph"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "t:settings_schema.social.settings.social_instagram.label"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "t:settings_schema.social.settings.social_facebook.label"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "t:settings_schema.social.settings.social_youtube.label"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "t:settings_schema.social.settings.social_tiktok.label"
      }
    ]
  },
  {
    "name": "t:settings_schema.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      }
    ]
