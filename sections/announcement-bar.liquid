{% if section.settings.text != blank %}
  <div class="announcement" style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};" {{ section.shopify_attributes }}>
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
    <p>{{ section.settings.text }}</p>
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "section-announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement-bar.settings.text.label",
      "default": "t:sections.announcement-bar.settings.text.default"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FCF6ED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0D0D0D"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.name"
    }
  ]
}
{% endschema %}
