{%- liquid
  assign currency_code = cart.currency.iso_code | default: localization.country.currency.iso_code | default: shop.currency
  assign money_factor = 100
  if section.settings.money_subunit_factor > 0
    assign money_factor = section.settings.money_subunit_factor
  else
    assign zero_decimal = 'BIF,CLF,CLP,DJF,GNF,ISK,JPY,KMF,KRW,PYG,RWF,UGX,UYI,VND,VUV,XAF,XOF,XPF' | split: ','
    assign three_decimal = 'BHD,IQD,JOD,KWD,LYD,OMR,TND' | split: ','
    if zero_decimal contains currency_code
      assign money_factor = 1
    elsif three_decimal contains currency_code
      assign money_factor = 1000
    endif
  endif

  assign free_ship = section.settings.free_shipping_threshold | times: money_factor
  assign cart_total = cart.total_price
  assign remaining = free_ship | minus: cart_total
  if remaining < 0
    assign remaining = 0
  endif
  if free_ship > 0
    assign progress_pct = cart_total | times: 100.0 | divided_by: free_ship
    if progress_pct > 100
      assign progress_pct = 100
    endif
  else
    assign progress_pct = 100
  endif
-%}

<div class="cart-drawer" data-cart {% unless cart.item_count > 0 %}data-cart-empty{% endunless %} hidden>
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cart-title-{{ section.id }}">
    <div class="cart-drawer__head">
      <div class="cart-drawer__title-row">
        <h2 id="cart-title-{{ section.id }}">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ 'cart.general.title' | t }}
          {%- endif -%}
        </h2>
        <span class="cart-drawer__count" aria-label="{{ 'cart.general.item_count' | t: count: cart.item_count }}">
          {{ cart.item_count }}
        </span>
      </div>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'cart-close', width: 22, height: 22 %}
      </button>
    </div>

    <div class="cart-drawer__body">
      {%- if section.settings.show_free_shipping -%}
        {%- if remaining > 0 -%}
          <p class="cart-drawer__progress-text">
            {%- if section.settings.progress_prefix != blank -%}
              {{ section.settings.progress_prefix }}
            {%- else -%}
              {{ 'cart.general.progress_prefix' | t }}
            {%- endif -%}
            <strong>{{ remaining | money }}</strong>
            {%- if section.settings.progress_suffix != blank -%}
              {{ section.settings.progress_suffix }}
            {%- else -%}
              {{ 'cart.general.progress_suffix' | t }}
            {%- endif -%}
          </p>
        {%- else -%}
          <p class="cart-drawer__progress-text">
            <strong>
              {%- if section.settings.progress_unlocked != blank -%}
                {{ section.settings.progress_unlocked }}
              {%- else -%}
                {{ 'cart.general.progress_unlocked' | t }}
              {%- endif -%}
            </strong>
          </p>
        {%- endif -%}

        <div class="cart-drawer__tiers" aria-hidden="true">
          <div class="cart-drawer__tier-track">
            <span class="cart-drawer__tier-fill" style="width: {{ progress_pct }}%"></span>
          </div>
          {%- for block in section.blocks -%}
            {%- if block.type == 'tier' -%}
              {%- liquid
                assign tier_amount = block.settings.amount | times: money_factor
                assign tier_done = false
                if cart_total >= tier_amount
                  assign tier_done = true
                endif
              -%}
              <div
                class="cart-drawer__tier{% if tier_done %} cart-drawer__tier--done{% endif %}"
                style="--tier-x: {{ block.settings.position }}%"
                {{ block.shopify_attributes }}
              >
                <span class="cart-drawer__tier-amount">{{ tier_amount | money_without_trailing_zeros }}</span>
                {% render 'icon', name: 'cart-tier-check', width: 16, height: 16, class: 'cart-drawer__tier-dot' %}
                <span class="cart-drawer__tier-label">{{ block.settings.label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if cart.item_count == 0 -%}
        <p class="cart-drawer__empty">{{ 'cart.general.empty' | t }}</p>
      {%- else -%}
        <ul class="cart-drawer__lines">
          {%- for item in cart.items -%}
            <li class="cart-line" data-key="{{ item.key }}">
              {%- if item.image -%}
                <a href="{{ item.url }}">
                  {{ item.image | image_url: width: 140 | image_tag: class: 'cart-line__img', width: 70, height: 86, loading: 'lazy', alt: item.product.title }}
                </a>
              {%- endif -%}
              <div class="cart-line__info">
                <div class="cart-line__top">
                  <p class="cart-line__name">
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                  </p>
                  <p class="cart-line__price">{{ item.final_line_price | money }}</p>
                </div>
                {%- if item.product.description != blank -%}
                  <p class="cart-line__meta">{{ item.product.description | strip_html | truncate: 40 }}</p>
                {%- endif -%}
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__size">
                    {%- for option in item.options_with_values -%}
                      {{ option.value }}{% unless forloop.last %} / {% endunless %}
                    {%- endfor -%}
                  </p>
                {%- endunless -%}
                <div class="cart-line__actions">
                  <div class="cart-qty" data-qty>
                    <button type="button" data-qty-minus aria-label="{{ 'products.product.quantity.decrease' | t }}">−</button>
                    <span data-qty-value>{{ item.quantity }}</span>
                    <button type="button" data-qty-plus aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="cart-line__remove">{{ 'cart.general.remove' | t }}</a>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.ship_note != blank -%}
        <div class="cart-drawer__ship-note">
          <p>{{ section.settings.ship_note }}</p>
          <span class="cart-drawer__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
      {%- endif -%}

      {%- if section.settings.bestsellers_collection != blank -%}
        {%- assign bs = collections[section.settings.bestsellers_collection] -%}
        {%- if bs != blank and bs.products_count > 0 -%}
          <div class="cart-drawer__bestsellers">
            <div class="cart-drawer__bestsellers-head">
              <h3>
                {%- if section.settings.bestsellers_heading != blank -%}
                  {{ section.settings.bestsellers_heading }}
                {%- else -%}
                  {{ 'cart.general.bestsellers' | t }}
                {%- endif -%}
              </h3>
              <div class="cart-drawer__bestsellers-nav">
                <button type="button" class="cart-best-prev" aria-label="{{ 'general.pagination.previous' | t }}">
                  <svg width="8" height="12" viewBox="0 0 8 12" fill="none" aria-hidden="true"><path d="M7 1L2 6l5 5" stroke="#0D0D0D" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button" class="cart-best-next" aria-label="{{ 'general.pagination.next' | t }}">
                  <svg width="8" height="12" viewBox="0 0 8 12" fill="none" aria-hidden="true"><path d="M1 1l5 5-5 5" stroke="#0D0D0D" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
            <div class="swiper cart-best-swiper">
              <div class="swiper-wrapper">
                {%- for product in bs.products limit: section.settings.bestsellers_limit -%}
                  <article class="cart-mini swiper-slide">
                    {%- if product.featured_media -%}
                      {{ product.featured_media | image_url: width: 150 | image_tag: width: 75, height: 75, loading: 'lazy', alt: product.title }}
                    {%- endif -%}
                    <div class="cart-mini__body">
                      <p class="cart-mini__name">{{ product.title }}</p>
                      <p class="cart-mini__meta">{{ product.description | strip_html | truncate: 40 }}</p>
                      <p class="cart-mini__meta-row">
                        <span>{{ product.price | money }}</span>
                      </p>
                    </div>
                    {% form 'product', product %}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" name="add" class="cart-mini__add">{{ 'products.product.add' | t }}</button>
                    {% endform %}
                  </article>
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_promo -%}
        <button type="button" class="cart-drawer__promo" data-cart-promo>
          {% render 'icon', name: 'cart-plus', width: 20, height: 20, class: 'cart-drawer__promo-icon' %}
          {%- if section.settings.promo_label != blank -%}
            {{ section.settings.promo_label }}
          {%- else -%}
            {{ 'cart.general.discount_code' | t }}
          {%- endif -%}
        </button>
      {%- endif -%}
    </div>

    <div class="cart-drawer__foot">
      {%- if section.settings.checkout_direct -%}
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="cart-drawer__checkout" {% if cart.item_count == 0 %}disabled{% endif %}>
            {%- if section.settings.checkout_label != blank -%}
              {{ section.settings.checkout_label }}
            {%- else -%}
              {{ 'cart.general.checkout' | t }}
            {%- endif -%}
            {%- if cart.item_count > 0 -%}
              &nbsp;•&nbsp;{{ cart.total_price | money }}
            {%- endif -%}
          </button>
        </form>
      {%- else -%}
        <a href="{{ routes.cart_url }}" class="cart-drawer__checkout{% if cart.item_count == 0 %} is-disabled{% endif %}">
          {%- if section.settings.checkout_label != blank -%}
            {{ section.settings.checkout_label }}
          {%- else -%}
            {{ 'cart.general.checkout' | t }}
          {%- endif -%}
          {%- if cart.item_count > 0 -%}
            &nbsp;•&nbsp;{{ cart.total_price | money }}
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "t:sections.cart-drawer.name",
  "class": "section-cart-drawer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.cart-drawer.settings.heading.label",
      "default": "t:sections.cart-drawer.settings.heading.default"
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping",
      "label": "Show free shipping progress",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "t:sections.cart-drawer.settings.free_shipping_threshold.label",
      "default": 45,
      "info": "t:sections.cart-drawer.settings.free_shipping_threshold.info"
    },
    {
      "type": "number",
      "id": "money_subunit_factor",
      "label": "t:sections.cart-drawer.settings.money_subunit_factor.label",
      "default": 0,
      "info": "t:sections.cart-drawer.settings.money_subunit_factor.info"
    },
    {
      "type": "text",
      "id": "progress_prefix",
      "label": "t:sections.cart-drawer.settings.progress_prefix.label",
      "default": "t:sections.cart-drawer.settings.progress_prefix.default"
    },
    {
      "type": "text",
      "id": "progress_suffix",
      "label": "t:sections.cart-drawer.settings.progress_suffix.label",
      "default": "t:sections.cart-drawer.settings.progress_suffix.default"
    },
    {
      "type": "text",
      "id": "progress_unlocked",
      "label": "t:sections.cart-drawer.settings.progress_unlocked.label",
      "default": "t:sections.cart-drawer.settings.progress_unlocked.default"
    },
    {
      "type": "text",
      "id": "ship_note",
      "label": "t:sections.cart-drawer.settings.progress_locked.label",
      "default": "t:sections.cart-drawer.settings.progress_locked.default"
    },
    {
      "type": "collection",
      "id": "bestsellers_collection",
      "label": "Bestsellers collection"
    },
    {
      "type": "text",
      "id": "bestsellers_heading",
      "label": "t:sections.cart-drawer.settings.bestsellers_heading.label",
      "default": "t:sections.cart-drawer.settings.bestsellers_heading.default"
    },
    {
      "type": "range",
      "id": "bestsellers_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Bestsellers limit",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show promo code button",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_label",
      "label": "t:sections.cart-drawer.settings.discount_label.label",
      "default": "t:sections.cart-drawer.settings.discount_label.default"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "t:sections.cart-drawer.settings.checkout_label.label",
      "default": "t:sections.cart-drawer.settings.checkout_label.default"
    },
    {
      "type": "checkbox",
      "id": "checkout_direct",
      "label": "Use checkout submit form instead of cart link",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Reward tier",
      "limit": 5,
      "settings": [
        {
          "type": "number",
          "id": "amount",
          "label": "t:sections.cart-drawer.blocks.tier.settings.amount.label",
          "default": 20,
          "info": "t:sections.cart-drawer.blocks.tier.settings.amount.info"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Livraison OFFERTE"
        },
        {
          "type": "range",
          "id": "position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Position on bar",
          "default": 19
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cart drawer",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "amount": 20,
            "label": "Livraison OFFERTE",
            "position": 19
          }
        },
        {
          "type": "tier",
          "settings": {
            "amount": 30,
            "label": "Mini crème repulpante OFFERTE",
            "position": 35
          }
        },
        {
          "type": "tier",
          "settings": {
            "amount": 70,
            "label": "Mini crème repulpante OFFERTE",
            "position": 55
          }
        }
      ]
    }
  ]
}
{% endschema %}
