{% render 'section-spacing' %}

{%- liquid
  assign footer_logo = section.settings.logo
  assign social_strip = section.settings.social_strip
  assign root_url = routes.root_url
  assign journal_url = root_url
  if blogs.news != blank
    assign journal_url = blogs.news.url
  endif
  assign about_url = '#founders'
  if pages.about != blank
    assign about_url = pages.about.url
  endif
  assign legal_cgv = '#'
  if pages.cgv != blank
    assign legal_cgv = pages.cgv.url
  endif
  assign legal_mentions = '#'
  if pages['mentions-legales'] != blank
    assign legal_mentions = pages['mentions-legales'].url
  endif
  assign legal_privacy = '#'
  if pages['politique-de-confidentialite'] != blank
    assign legal_privacy = pages['politique-de-confidentialite'].url
  endif
-%}

<footer class="site-footer section-pad" data-section="footer" style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};">
  <div class="footer-inner">
    <div class="footer-brand">
      {%- if footer_logo != blank -%}
        {{
          footer_logo
          | image_url: width: 600
          | image_tag: class: 'footer-logo', widths: '300,450,600', alt: shop.name, loading: 'lazy'
        }}
      {%- else -%}
        <img
          class="footer-logo"
          src="{{ 'logo-wide.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="336"
          height="40"
          loading="lazy"
        >
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p>{{ section.settings.tagline }}</p>
      {%- endif -%}

      <div class="footer-newsletter">
        {%- if section.settings.newsletter_heading != blank -%}
          <h3>{{ section.settings.newsletter_heading }}</h3>
        {%- endif -%}
        {%- if section.settings.newsletter_text != blank -%}
          <p>{{ section.settings.newsletter_text }}</p>
        {%- endif -%}
        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input
            id="NewsletterForm--{{ section.id }}"
            type="email"
            name="contact[email]"
            placeholder="{% if section.settings.newsletter_placeholder != blank %}{{ section.settings.newsletter_placeholder }}{% else %}{{ 'newsletter.placeholder' | t }}{% endif %}"
            required
            autocomplete="email"
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
          <button class="btn btn--dark" type="submit">
            {%- if section.settings.newsletter_button != blank -%}
              {{ section.settings.newsletter_button }}
            {%- else -%}
              {{ 'newsletter.button' | t }}
            {%- endif -%}
          </button>
          {%- if form.posted_successfully? -%}
            <p class="newsletter-form__success" role="status">{{ 'newsletter.success' | t }}</p>
          {%- endif -%}
        {% endform %}
      </div>

      <nav class="footer-social" aria-label="{{ 'general.social.links' | t }}">
        {%- if social_strip != blank -%}
          {{
            social_strip
            | image_url: width: 372
            | image_tag: class: 'footer-social__strip', width: 186, height: 55, loading: 'lazy', alt: ''
          }}
        {%- else -%}
          <img
            class="footer-social__strip"
            src="{{ 'social-icons.png' | asset_url }}"
            alt=""
            width="186"
            height="55"
            loading="lazy"
          >
        {%- endif -%}

        {%- assign has_social_hits = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'social_hit' -%}
            {%- assign has_social_hits = true -%}
            {%- liquid
              assign hit_url = blank
              assign hit_label = blank
              case block.settings.network
                when 'instagram'
                  assign hit_url = settings.social_instagram | default: 'https://www.instagram.com/'
                  assign hit_label = 'Instagram'
                when 'facebook'
                  assign hit_url = settings.social_facebook | default: 'https://www.facebook.com/'
                  assign hit_label = 'Facebook'
                when 'youtube'
                  assign hit_url = settings.social_youtube | default: 'https://www.youtube.com/'
                  assign hit_label = 'YouTube'
                when 'tiktok'
                  assign hit_url = settings.social_tiktok | default: 'https://www.tiktok.com/'
                  assign hit_label = 'TikTok'
              endcase
            -%}
            <a
              class="footer-social__hit"
              href="{{ hit_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="{{ hit_label | escape }}"
              style="left: {{ block.settings.left }}%; width: {{ block.settings.width }}%;"
              {{ block.shopify_attributes }}
            ></a>
          {%- endif -%}
        {%- endfor -%}

        {%- unless has_social_hits -%}
          <a class="footer-social__hit" href="{{ settings.social_instagram | default: 'https://www.instagram.com/' }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="left: 8%"></a>
          <a class="footer-social__hit" href="{{ settings.social_facebook | default: 'https://www.facebook.com/' }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="left: 32%"></a>
          <a class="footer-social__hit" href="{{ settings.social_youtube | default: 'https://www.youtube.com/' }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" style="left: 56%"></a>
          <a class="footer-social__hit" href="{{ settings.social_tiktok | default: 'https://www.tiktok.com/' }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" style="left: 78%"></a>
        {%- endunless -%}
      </nav>
    </div>

    <div class="footer-cols">
      {%- assign link_columns = section.blocks | where: 'type', 'link_column' -%}
      {%- if link_columns.size > 0 -%}
        {%- for block in link_columns -%}
          <details class="footer-col" open {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading }}</summary>
            {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
              <ul>
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              {%- case forloop.index -%}
                {%- when 1 -%}
                  <ul>
                    <li><a href="#founders">Où nous trouver ?</a></li>
                    <li><a href="#founders">Contact - SAV</a></li>
                    <li><a href="#founders">Questions fréquentes</a></li>
                    <li><a href="#founders">Parrainez vos amis</a></li>
                  </ul>
                {%- when 2 -%}
                  <ul>
                    <li><a href="{{ journal_url }}">Le Journal</a></li>
                    <li><a href="{{ about_url }}">Notre histoire</a></li>
                  </ul>
                {%- when 3 -%}
                  <ul>
                    <li><a href="#founders">Vous êtes une pharmacie ?</a></li>
                    <li><a href="#founders">Vous êtes un revendeur ?</a></li>
                  </ul>
              {%- endcase -%}
            {%- endif -%}
          </details>
        {%- endfor -%}
      {%- else -%}
        <details class="footer-col" open>
          <summary>SERVICE CLIENT</summary>
          <ul>
            <li><a href="#founders">Où nous trouver ?</a></li>
            <li><a href="#founders">Contact - SAV</a></li>
            <li><a href="#founders">Questions fréquentes</a></li>
            <li><a href="#founders">Parrainez vos amis</a></li>
          </ul>
        </details>
        <details class="footer-col" open>
          <summary>LES PETITS PRÖDIGES</summary>
          <ul>
            <li><a href="{{ journal_url }}">Le Journal</a></li>
            <li><a href="{{ about_url }}">Notre histoire</a></li>
          </ul>
        </details>
        <details class="footer-col" open>
          <summary>REJOIGNEZ L’AVENTURE</summary>
          <ul>
            <li><a href="#founders">Vous êtes une pharmacie ?</a></li>
            <li><a href="#founders">Vous êtes un revendeur ?</a></li>
          </ul>
        </details>
      {%- endif -%}

      {% render 'localization-form',
        id: 'footer',
        class: 'footer-locale',
        enable_country: section.settings.enable_country_selector,
        enable_language: section.settings.enable_language_selector
      %}
    </div>

    <div class="footer-legal">
      <nav>
        {%- if section.settings.legal_menu != blank and linklists[section.settings.legal_menu].links.size > 0 -%}
          {%- for link in linklists[section.settings.legal_menu].links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="{{ legal_cgv }}">CGV / CGU</a>
          <a href="{{ legal_mentions }}">MENTIONS LÉGALES</a>
          <a href="{{ legal_privacy }}">POLITIQUE DE CONFIDENTIALITÉ</a>
        {%- endif -%}
      </nav>
      <p>
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}
        {{ section.settings.copyright }}
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Brand logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "t:sections.footer.settings.tagline.label",
      "default": "t:sections.footer.settings.tagline.default"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.footer.settings.newsletter_heading.label",
      "default": "t:sections.footer.settings.newsletter_heading.default"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "t:sections.footer.settings.newsletter_text.label",
      "default": "t:sections.footer.settings.newsletter_text.default"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "t:sections.footer.settings.newsletter_placeholder.label",
      "default": "t:sections.footer.settings.newsletter_placeholder.default"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "t:sections.footer.settings.newsletter_button.label",
      "default": "t:sections.footer.settings.newsletter_button.default"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "image_picker",
      "id": "social_strip",
      "label": "t:sections.footer.settings.social_strip.label",
      "info": "t:sections.footer.settings.social_strip.info"
    },
    {
      "type": "header",
      "content": "Language & country"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Show country / currency selector",
      "default": true,
      "info": "Uses Shopify Markets. Labels update from the active market (e.g. FR / EUR)."
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Show language selector",
      "default": true,
      "info": "Uses Shopify Markets. Label uses the language endonym (e.g. Français)."
    },
    {
      "type": "header",
      "content": "Legal"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "t:sections.footer.settings.copyright.label",
      "default": "t:sections.footer.settings.copyright.default",
      "info": "Shown as: © {year} {shop name} {this text}. Shop name is always dynamic."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0D0D0D"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "t:sections.footer.blocks.link_column.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.link_column.settings.heading.label",
          "default": "t:sections.footer.blocks.link_column.settings.heading.default"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "social_hit",
      "name": "t:sections.footer.blocks.social_hit.name",
      "limit": 4,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.social_hit.settings.paragraph"
        },
        {
          "type": "select",
          "id": "network",
          "label": "t:sections.footer.blocks.social_hit.settings.network.label",
          "options": [
            {
              "value": "instagram",
              "label": "t:sections.footer.blocks.social_hit.settings.network.options.instagram"
            },
            {
              "value": "facebook",
              "label": "t:sections.footer.blocks.social_hit.settings.network.options.facebook"
            },
            {
              "value": "youtube",
              "label": "t:sections.footer.blocks.social_hit.settings.network.options.youtube"
            },
            {
              "value": "tiktok",
              "label": "t:sections.footer.blocks.social_hit.settings.network.options.tiktok"
            }
          ],
          "default": "instagram",
          "info": "t:sections.footer.blocks.social_hit.settings.network.info"
        },
        {
          "type": "range",
          "id": "left",
          "min": 0,
          "max": 90,
          "step": 1,
          "unit": "%",
          "label": "t:sections.footer.blocks.social_hit.settings.left.label",
          "default": 8
        },
        {
          "type": "range",
          "id": "width",
          "min": 8,
          "max": 40,
          "step": 1,
          "unit": "%",
          "label": "t:sections.footer.blocks.social_hit.settings.width.label",
          "default": 25
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "heading": "SERVICE CLIENT"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "LES PETITS PRÖDIGES"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "REJOIGNEZ L’AVENTURE"
          }
        },
        {
          "type": "social_hit",
          "settings": {
            "network": "instagram",
            "left": 8,
            "width": 25
          }
        },
        {
          "type": "social_hit",
          "settings": {
            "network": "facebook",
            "left": 32,
            "width": 25
          }
        },
        {
          "type": "social_hit",
          "settings": {
            "network": "youtube",
            "left": 56,
            "width": 25
          }
        },
        {
          "type": "social_hit",
          "settings": {
            "network": "tiktok",
            "left": 78,
            "width": 25
          }
        }
      ]
    }
  ]
}
{% endschema %}
