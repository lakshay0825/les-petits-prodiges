{% render 'section-spacing' %}

<section class="founders section-pad" id="{{ section.settings.anchor_id | default: 'founders' }}" data-section="founders">
  <div class="founders__text">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="founders__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.names != blank -%}
      <p class="founders__names">{{ section.settings.names }}</p>
    {%- endif -%}
  </div>
  <div class="founders__media">
    <picture>
      {%- if section.settings.image_desktop != blank -%}
        <source media="(min-width: 990px)" srcset="{{ section.settings.image_desktop | image_url: width: 1200 }}">
      {%- endif -%}
      {%- if section.settings.image_mobile != blank -%}
        {{
          section.settings.image_mobile
          | image_url: width: 900
          | image_tag:
            widths: '402,600,800,900',
            sizes: '(min-width: 990px) 40vw, 100vw',
            alt: section.settings.image_alt | default: section.settings.names,
            loading: 'lazy',
            width: 402,
            height: 469
        }}
      {%- elsif section.settings.image_desktop != blank -%}
        {{
          section.settings.image_desktop
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            alt: section.settings.image_alt | default: section.settings.names
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'founders__placeholder' }}
      {%- endif -%}
    </picture>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.founders.name",
  "tag": "section",
  "class": "section-founders",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID",
      "default": "founders"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.founders.settings.heading.label",
      "default": "t:sections.founders.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.founders.settings.text.label",
      "default": "t:sections.founders.settings.text.default"
    },
    {
      "type": "text",
      "id": "names",
      "label": "t:sections.founders.settings.names.label",
      "default": "t:sections.founders.settings.names.default"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image (desktop)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.founders.settings.image_alt.label",
      "default": "t:sections.founders.settings.image_alt.default"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.founders.name"
    }
  ]
}
{% endschema %}
