{% render 'section-spacing' %}

{%- liquid
  assign has_hero_media = false
  if section.settings.video_desktop != blank or section.settings.video_mobile != blank
    assign has_hero_media = true
  endif
  if section.settings.image_mobile != blank or section.settings.image_desktop != blank
    assign has_hero_media = true
  endif
-%}

<section
  class="hero section-pad{% unless has_hero_media %} hero--placeholder{% endunless %}"
  data-section="hero"
  id="{{ section.settings.anchor_id | default: 'hero' }}"
>
  <div class="hero__media">
    {%- if section.settings.video_desktop != blank or section.settings.video_mobile != blank -%}
      <video
        class="hero__video desktop-only"
        autoplay
        muted
        loop
        playsinline
        {% if section.settings.image_desktop != blank %}poster="{{ section.settings.image_desktop | image_url: width: 2000 }}"{% endif %}
      >
        {%- if section.settings.video_desktop != blank -%}
          <source src="{{ section.settings.video_desktop }}" type="video/mp4">
        {%- endif -%}
      </video>
      <video
        class="hero__video mobile-only"
        autoplay
        muted
        loop
        playsinline
        {% if section.settings.image_mobile != blank %}poster="{{ section.settings.image_mobile | image_url: width: 1000 }}"{% endif %}
      >
        {%- if section.settings.video_mobile != blank -%}
          <source src="{{ section.settings.video_mobile }}" type="video/mp4">
        {%- elsif section.settings.video_desktop != blank -%}
          <source src="{{ section.settings.video_desktop }}" type="video/mp4">
        {%- endif -%}
      </video>
    {%- elsif section.settings.image_mobile != blank or section.settings.image_desktop != blank -%}
      <picture>
        {%- if section.settings.image_desktop != blank -%}
          <source
            media="(min-width: 990px)"
            srcset="{{ section.settings.image_desktop | image_url: width: 2000 }} 2000w, {{ section.settings.image_desktop | image_url: width: 1512 }} 1512w"
          >
        {%- endif -%}
        {%- if section.settings.image_mobile != blank -%}
          {{
            section.settings.image_mobile
            | image_url: width: 900
            | image_tag:
              class: 'hero__img hero__img--primary',
              widths: '402,600,800,900',
              sizes: '100vw',
              alt: section.settings.heading,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- else -%}
          {{
            section.settings.image_desktop
            | image_url: width: 2000
            | image_tag:
              class: 'hero__img hero__img--primary',
              widths: '800,1200,1512,2000',
              sizes: '100vw',
              alt: section.settings.heading,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- endif -%}
      </picture>
      {%- if section.settings.image_secondary != blank -%}
        {{
          section.settings.image_secondary
          | image_url: width: 1200
          | image_tag:
            class: 'hero__img hero__img--secondary',
            widths: '600,900,1200',
            alt: '',
            loading: 'lazy',
            aria-hidden: 'true'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hero__img hero__img--primary hero__placeholder' }}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__img hero__img--secondary hero__placeholder' }}
    {%- endif -%}
  </div>

  <div class="hero__content">
    {%- if section.settings.tag != blank -%}
      <span class="tag">{{ section.settings.tag }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1>{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__sub desktop-only">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn--solid-light hero__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.show_product_card -%}
    {%- if section.settings.featured_product != blank -%}
      {%- assign hero_product = section.settings.featured_product -%}
      <a class="hero-card" href="{{ hero_product.url }}">
        {%- if hero_product.featured_media -%}
          {{ hero_product.featured_media | image_url: width: 168 | image_tag: width: 84, height: 84, loading: 'lazy', alt: hero_product.title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'hero-card__placeholder' }}
        {%- endif -%}
        <div class="hero-card__info">
          <p class="hero-card__title">{{ hero_product.title }}</p>
          {%- if hero_product.description != blank -%}
            <p class="hero-card__meta">{{ hero_product.description | strip_html | truncate: 45 }}</p>
          {%- endif -%}
          <p class="hero-card__price">
            <span>{{ hero_product.price | money }}</span>
          </p>
        </div>
      </a>
    {%- else -%}
      <a class="hero-card" href="{{ routes.all_products_collection_url }}">
        {{ 'product-1' | placeholder_svg_tag: 'hero-card__placeholder' }}
        <div class="hero-card__info">
          <p class="hero-card__title">{{ section.settings.heading }}</p>
          {%- if section.settings.subheading != blank -%}
            <p class="hero-card__meta">{{ section.settings.subheading | truncate: 45 }}</p>
          {%- endif -%}
        </div>
      </a>
    {%- endif -%}
  {%- endif -%}

  <div class="hero-video mobile-only" data-hero-video>
    {%- if section.settings.pip_image != blank -%}
      {{
        section.settings.pip_image
        | image_url: width: 240
        | image_tag: width: 120, height: 200, loading: 'lazy', alt: ''
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'hero-video__placeholder' }}
    {%- endif -%}
    <button type="button" class="hero-video__close" data-hero-video-close aria-label="{{ 'accessibility.close' | t }}">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 3l8 8M11 3L3 11" stroke="#fff" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</section>

{%- if section.settings.show_diagnostic_sticky -%}
  {%- liquid
    assign diagnostic_href = section.settings.diagnostic_link
    if diagnostic_href == blank
      assign diagnostic_href = '#diagnostic'
    endif
    assign diagnostic_label = section.settings.diagnostic_label
    if diagnostic_label == blank
      assign diagnostic_label = 'sections.hero.diagnostic' | t
    endif
  -%}
  <a class="diagnostic-sticky mobile-only" href="{{ diagnostic_href }}" data-diagnostic-sticky>
    {% render 'icon', name: 'diagnostic-arrow', width: 20, height: 20 %}
    <span>{{ diagnostic_label }}</span>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID",
      "default": "hero"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "t:sections.hero.settings.tag.label",
      "default": "t:sections.hero.settings.tag.default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label",
      "default": "t:sections.hero.settings.heading.default"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.hero.settings.text.label",
      "default": "t:sections.hero.settings.text.default"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.hero.settings.button_label.label",
      "default": "t:sections.hero.settings.button_label.default"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "Secondary image (desktop)"
    },
    {
      "type": "text",
      "id": "video_mobile",
      "label": "Video URL (mobile)",
      "info": "MP4 URL — optional, overrides image on mobile"
    },
    {
      "type": "text",
      "id": "video_desktop",
      "label": "Video URL (desktop)",
      "info": "MP4 URL — optional"
    },
    {
      "type": "image_picker",
      "id": "pip_image",
      "label": "Mobile PIP video image"
    },
    {
      "type": "header",
      "content": "Featured product card"
    },
    {
      "type": "checkbox",
      "id": "show_product_card",
      "label": "Show product card",
      "default": true
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    },
    {
      "type": "header",
      "content": "Sticky diagnostic"
    },
    {
      "type": "checkbox",
      "id": "show_diagnostic_sticky",
      "label": "Show mobile sticky diagnostic CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "diagnostic_label",
      "label": "t:sections.hero.settings.sticky_label.label",
      "default": "t:sections.hero.settings.sticky_label.default"
    },
    {
      "type": "url",
      "id": "diagnostic_link",
      "label": "Sticky link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
