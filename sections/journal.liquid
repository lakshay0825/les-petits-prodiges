{% render 'section-spacing' %}

{%- assign blog = blogs[section.settings.blog] -%}

<section class="journal section-pad" id="{{ section.settings.anchor_id | default: 'journal' }}" data-section="journal">
  <div class="journal__head">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.show_see_all -%}
      <a class="link-underline" href="{{ section.settings.see_all_link | default: blog.url }}">
        {{ section.settings.see_all_label | default: 'Voir tout' }}
      </a>
    {%- endif -%}
  </div>

  <div class="journal__slider">
    <button type="button" class="carousel-arrow journal-prev desktop-only" aria-label="{{ 'general.pagination.previous' | t }}">‹</button>
    <div class="swiper journal-swiper">
      <div class="swiper-wrapper">
        {%- if blog != blank -%}
          {%- for article in blog.articles limit: section.settings.articles_to_show -%}
            <article class="journal-card swiper-slide">
              <a href="{{ article.url }}">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300,500,800',
                      sizes: '(min-width: 990px) 25vw, 70vw',
                      alt: article.image.alt | default: article.title
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
                <h3>{{ article.title }}</h3>
              </a>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <article class="journal-card swiper-slide">
              <a href="#">
                {{ 'image' | placeholder_svg_tag }}
                <h3>{{ 'blogs.article.onboarding_title' | t }}</h3>
              </a>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    <button type="button" class="carousel-arrow journal-next desktop-only" aria-label="{{ 'general.pagination.next' | t }}">›</button>
  </div>
  <div class="carousel-dots journal-pagination"></div>
</section>

{% schema %}
{
  "name": "t:sections.journal.name",
  "tag": "section",
  "class": "section-journal",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID",
      "default": "journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.journal.settings.heading.label",
      "default": "t:sections.journal.settings.heading.default"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Articles to show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_see_all",
      "label": "Show see all link",
      "default": true
    },
    {
      "type": "text",
      "id": "see_all_label",
      "label": "t:sections.journal.settings.see_all_label.label",
      "default": "t:sections.journal.settings.see_all_label.default"
    },
    {
      "type": "url",
      "id": "see_all_link",
      "label": "See all link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.journal.name"
    }
  ]
}
{% endschema %}
