{% render 'section-spacing' %}

<section class="main-404 section-pad" data-section="main-404">
  <h1>
    {%- if section.settings.heading != blank -%}
      {{ section.settings.heading }}
    {%- else -%}
      {{ 'general.404.title' | t }}
    {%- endif -%}
  </h1>
  {%- if section.settings.text != blank -%}
    <p>{{ section.settings.text }}</p>
  {%- else -%}
    <p>{{ 'general.404.subtext' | t }}</p>
  {%- endif -%}
  <a class="btn btn--dark" href="{{ routes.root_url }}">
    {%- if section.settings.button_label != blank -%}
      {{ section.settings.button_label }}
    {%- else -%}
      {{ 'general.404.link' | t }}
    {%- endif -%}
  </a>
</section>

{% schema %}
{
  "name": "t:sections.main-404.name",
  "class": "section-main-404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main-404.settings.heading.label",
      "default": "t:sections.main-404.settings.heading.default"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.main-404.settings.text.label",
      "default": "t:sections.main-404.settings.text.default"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.main-404.settings.button_label.label",
      "default": "t:sections.main-404.settings.button_label.default"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 80
    }
  ]
}
{% endschema %}
