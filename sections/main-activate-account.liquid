{% render 'section-spacing' %}

<section class="page-shell customer customer-activate section-pad" data-section="main-activate-account">
  <h1>{{ 'customer.activate_account.title' | t }}</h1>
  <p>{{ 'customer.activate_account.subtext' | t }}</p>

  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}
      <div class="customer__errors" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="customer__field">
      <label for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
      <input
        type="password"
        name="customer[password]"
        id="ActivatePassword"
        autocomplete="new-password"
        {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
      >
    </div>

    <div class="customer__field">
      <label for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input
        type="password"
        name="customer[password_confirmation]"
        id="ActivatePasswordConfirm"
        autocomplete="new-password"
        {% if form.errors contains 'password_confirmation' %}aria-invalid="true"{% endif %}
      >
    </div>

    <button type="submit" class="btn btn--dark">{{ 'customer.activate_account.submit' | t }}</button>
    <button type="submit" class="btn btn--outline" name="decline">{{ 'customer.activate_account.cancel' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Activate account",
  "class": "section-main-activate-account",
  "settings": []
}
{% endschema %}
