{% render 'section-spacing' %}

{%- liquid
  assign layout = section.settings.layout | default: 'mosaic'
  assign shell_class = 'page-shell--collection'
  if layout == 'all'
    assign shell_class = 'page-shell--collection-all'
  endif
  assign mosaic_insert_after = section.settings.promo_after | default: 3
-%}

<section class="main-collection section-pad" data-section="main-collection">
  {%- if section.settings.show_hero -%}
    <figure class="collection-hero">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            widths: '600,900,1200,1600',
            sizes: '100vw',
            alt: section.settings.hero_image.alt | default: collection.title
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </figure>
  {%- endif -%}

  <div class="page-shell {{ shell_class }}">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="breadcrumb{% if layout == 'all' %} desktop-only{% endif %}" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        <span aria-hidden="true"> / </span>
        <span>{{ collection.title }}</span>
      </nav>
    {%- endif -%}

    {%- if section.settings.show_title or section.settings.show_description -%}
      <header class="collection-intro{% if layout == 'all' %} collection-intro--all{% endif %}">
        {%- if section.settings.show_title -%}
          <h1>{{ collection.title }}</h1>
        {%- endif -%}
        {%- if section.settings.show_description and collection.description != blank -%}
          <p>{{ collection.description | strip_html }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if layout == 'all' -%}
      {%- if section.settings.category_menu != blank -%}
        <div class="collection-controls mobile-only">
          <div class="collection-controls__chips">
            {%- for link in linklists[section.settings.category_menu].links -%}
              <a
                class="collection-chip{% if forloop.first %} is-active{% endif %}"
                href="{{ link.url }}"
              >
                {{- link.title | escape -}}
              </a>
            {%- endfor -%}
          </div>
        </div>
        <div data-collection-sticky-sentinel aria-hidden="true"></div>
      {%- endif -%}
    {%- endif -%}

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if layout == 'mosaic' -%}
        <div class="collection-mosaic">
          {%- if section.settings.tile_tall_image != blank or section.settings.show_promo_tiles -%}
            <a
              class="collection-tile collection-tile--tall"
              href="{{ section.settings.tile_tall_link | default: collection.url }}"
              {% if section.settings.tile_tall_heading != blank %}aria-label="{{ section.settings.tile_tall_heading | escape }}"{% endif %}
            >
              {%- if section.settings.tile_tall_image != blank -%}
                {{
                  section.settings.tile_tall_image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 25vw, 50vw', alt: ''
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if section.settings.tile_tall_heading != blank -%}
                <div class="collection-tile__content">
                  <h2>{{ section.settings.tile_tall_heading }}</h2>
                  {%- if section.settings.tile_tall_cta != blank -%}
                    <span class="collection-tile__cta">{{ section.settings.tile_tall_cta }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </a>
          {%- endif -%}

          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}

            {%- if section.settings.show_promo_tiles and forloop.index == mosaic_insert_after -%}
              <a
                class="collection-tile collection-tile--wide collection-tile--fini"
                href="{{ section.settings.tile_wide_link | default: collection.url }}"
              >
                {%- if section.settings.tile_wide_image != blank -%}
                  {{
                    section.settings.tile_wide_image
                    | image_url: width: 1400
                    | image_tag: loading: 'lazy', widths: '600,900,1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: ''
                  }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag }}
                {%- endif -%}
                {%- if section.settings.tile_wide_heading != blank -%}
                  <div class="collection-tile__content collection-tile__content--fini">
                    <h2>{{ section.settings.tile_wide_heading }}</h2>
                  </div>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- else -%}
            <p>{{ 'collections.general.no_matches' | t }}</p>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- else -%}
            <p>{{ 'collections.general.no_matches' | t }}</p>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
          {%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{%- if layout == 'all' and section.settings.category_menu != blank -%}
  <div class="collection-sticky desktop-only" data-collection-sticky hidden>
    <div class="collection-sticky__inner">
      <button type="button" class="collection-sticky__fade collection-sticky__fade--prev" aria-label="{{ 'general.pagination.previous' | t }}" hidden></button>
      <div class="collection-sticky__chips" data-collection-chips>
        {%- for link in linklists[section.settings.category_menu].links -%}
          <a class="collection-chip{% if forloop.first %} is-active{% endif %}" href="{{ link.url }}">
            {{- link.title | escape -}}
          </a>
        {%- endfor -%}
      </div>
      <button type="button" class="collection-sticky__fade collection-sticky__fade--next" aria-label="{{ 'general.pagination.next' | t }}"></button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection products",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "mosaic", "label": "Mosaic (Figma collection)" },
        { "value": "all", "label": "Product grid (all products)" },
        { "value": "grid", "label": "Simple grid" }
      ],
      "default": "mosaic"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show collection hero banner",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 16
    },
    {
      "type": "header",
      "content": "Mosaic promo tiles"
    },
    {
      "type": "checkbox",
      "id": "show_promo_tiles",
      "label": "Show lifestyle promo tiles",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "tile_tall_image",
      "label": "Tall tile image"
    },
    {
      "type": "text",
      "id": "tile_tall_heading",
      "label": "Tall tile heading",
      "default": "Bilan de votre peau"
    },
    {
      "type": "text",
      "id": "tile_tall_cta",
      "label": "Tall tile CTA",
      "default": "Débuter"
    },
    {
      "type": "url",
      "id": "tile_tall_link",
      "label": "Tall tile link"
    },
    {
      "type": "image_picker",
      "id": "tile_wide_image",
      "label": "Wide tile image"
    },
    {
      "type": "text",
      "id": "tile_wide_heading",
      "label": "Wide tile heading",
      "default": "Fini invisible SPF50+ engagée"
    },
    {
      "type": "url",
      "id": "tile_wide_link",
      "label": "Wide tile link"
    },
    {
      "type": "range",
      "id": "promo_after",
      "min": 1,
      "max": 8,
      "step": 1,
      "label": "Insert wide tile after N products",
      "default": 3
    },
    {
      "type": "header",
      "content": "All-products layout"
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category chips menu"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 64
    }
  ]
}
{% endschema %}
