{% render 'section-spacing' %}

<section class="page-shell customer customer-login section-pad" data-section="main-login">
  <h1>{{ 'customer.login.title' | t }}</h1>

  {%- form 'customer_login' -%}
    {%- if form.errors -%}
      <div class="customer__errors" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="customer__field">
      <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
      <input
        type="email"
        name="customer[email]"
        id="CustomerEmail"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
        required
      >
    </div>

    <div class="customer__field">
      <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
      <input
        type="password"
        name="customer[password]"
        id="CustomerPassword"
        autocomplete="current-password"
        {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
        required
      >
    </div>

    <p>
      <a href="{{ routes.account_recover_url }}">{{ 'customer.login.forgot_password' | t }}</a>
    </p>

    <button type="submit" class="btn btn--dark">{{ 'customer.login.sign_in' | t }}</button>
  {%- endform -%}

  <p class="customer__alt">
    <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
  </p>

  {%- if shop.checkout.guest_login -%}
    <div class="customer__guest">
      <h2>{{ 'customer.login.guest_title' | t }}</h2>
      {%- form 'guest_login' -%}
        <button type="submit" class="btn btn--outline">{{ 'customer.login.guest_title' | t }}</button>
      {%- endform -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Customer login",
  "class": "section-main-login",
  "settings": []
}
{% endschema %}
