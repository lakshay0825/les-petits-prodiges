{% render 'section-spacing' %}

<section class="page-shell customer customer-order section-pad" data-section="main-order">
  <div class="customer__header">
    <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
    <a href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a>
  </div>

  {%- assign order_date = order.created_at | time_tag: format: 'date' -%}
  <p>{{ 'customer.order.date' | t: date: order_date }}</p>

  {%- if order.cancelled -%}
    {%- assign cancelled_date = order.cancelled_at | time_tag: format: 'date' -%}
    <div class="customer__errors" role="status">
      <p>{{ 'customer.order.cancelled' | t: date: cancelled_date }}</p>
      {%- if order.cancel_reason -%}
        <p>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="customer__table-wrap">
    <table class="customer__table">
      <thead>
        <tr>
          <th>{{ 'customer.order.product' | t }}</th>
          <th>{{ 'customer.order.sku' | t }}</th>
          <th>{{ 'customer.order.price' | t }}</th>
          <th>{{ 'customer.order.quantity' | t }}</th>
          <th>{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              {{ line_item.title | link_to: line_item.product.url }}
              {%- if line_item.fulfillment -%}
                {%- assign fulfilled_date = line_item.fulfillment.created_at | time_tag: format: 'date' -%}
                <p>
                  {{ 'customer.order.fulfillment' | t: date: fulfilled_date }}
                  {%- if line_item.fulfillment.tracking_url -%}
                    <br>
                    <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track_shipment' | t }}</a>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </td>
            <td>{{ line_item.sku }}</td>
            <td>{{ line_item.final_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4">{{ 'customer.order.subtotal' | t }}</td>
          <td>{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        {%- if order.cart_level_discount_applications != blank -%}
          {%- for discount in order.cart_level_discount_applications -%}
            <tr>
              <td colspan="4">{{ 'customer.order.discount' | t }} ({{ discount.title }})</td>
              <td>-{{ discount.total_allocated_amount | money }}</td>
            </tr>
          {%- endfor -%}
        {%- endif -%}
        {%- for shipping_method in order.shipping_methods -%}
          <tr>
            <td colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
            <td>{{ shipping_method.price | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr>
            <td colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {%- endfor -%}
        {%- if order.total_duties -%}
          <tr>
            <td colspan="4">{{ 'customer.order.total_duties' | t }}</td>
            <td>{{ order.total_duties | money }}</td>
          </tr>
        {%- endif -%}
        <tr>
          <td colspan="4"><strong>{{ 'customer.order.total' | t }}</strong></td>
          <td><strong>{{ order.total_price | money }}</strong></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="customer__grid">
    <div>
      <h2>{{ 'customer.order.billing_address' | t }}</h2>
      <p>{{ order.billing_address.name }}</p>
      {{ order.billing_address | format_address }}
      <p>{{ order.email }}</p>
    </div>
    <div>
      <h2>{{ 'customer.order.shipping_address' | t }}</h2>
      <p>{{ order.shipping_address.name }}</p>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer order",
  "class": "section-main-order",
  "settings": []
}
{% endschema %}
