<div class="password-page__inner" style="min-height:60vh;display:grid;place-items:center;padding:40px 24px;text-align:center;">
  <div>
    <h1 style="font-family:var(--font-display);font-size:28px;margin-bottom:16px;">{{ shop.name }}</h1>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input type="password" name="password" id="Password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
      <button type="submit" class="btn btn--dark">{{ 'general.password_page.login_form_submit' | t }}</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
