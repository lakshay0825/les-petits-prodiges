{% render 'section-spacing' %}

<section class="page-shell customer customer-recover section-pad" data-section="main-recover-password">
  <h1>{{ 'customer.recover_password.title' | t }}</h1>

  {%- form 'recover_customer_password' -%}
    {%- if form.posted_successfully? -%}
      <p role="status">{{ 'customer.recover_password.success' | t }}</p>
    {%- else -%}
      <p>{{ 'customer.recover_password.subtext' | t }}</p>

      {%- if form.errors -%}
        <div class="customer__errors" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="customer__field">
        <label for="RecoverEmail">{{ 'customer.recover_password.email' | t }}</label>
        <input
          type="email"
          name="email"
          id="RecoverEmail"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          {% if form.errors %}aria-invalid="true"{% endif %}
          required
        >
      </div>

      <button type="submit" class="btn btn--dark">{{ 'customer.recover_password.submit' | t }}</button>
    {%- endif -%}
  {%- endform -%}

  <p class="customer__alt">
    <a href="{{ routes.account_login_url }}">{{ 'customer.recover_password.cancel' | t }}</a>
  </p>
</section>

{% schema %}
{
  "name": "Recover password",
  "class": "section-main-recover-password",
  "settings": []
}
{% endschema %}
